# Upstream LLM provider credentials for agentgateway.
# Applied with:  op run --env-file=.env -- terraform apply
#
# Values are 1Password secret references, resolved by `op run` (never real
# secrets in this file). Mirrors openclaw/.env.
export TF_VAR_anthropic_api_key             = "op://private/claude-agentgw-wp-api-key/password"
export TF_VAR_deepseek_api_key              = "op://private/deepseek-agentgw-api-key/password"
export TF_VAR_openrouter_api_key            = "op://private/openrouter-agentgw-api-key/password"
export TF_VAR_gemini_api_key                = "op://private/gemini-agentgw-api-key/password"
export TF_VAR_openai_api_key                = "op://private/openai-agentgw-api-key/password"
export TF_VAR_claude_enterprise_api_key     = "op://private/claude-spglo-api-key/password"
export TF_VAR_lm_studio_api_key             = "op://private/llm-studio-server-key/password"