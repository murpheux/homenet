# Grafana. grafana-admin-email isn't in secrets.tfvars: add it to the item (see README).
TF_VAR_grafana_admin_password=op://private/homenet-grafana/password
# The grafana provider logs in with the admin credentials above. To use a service-account
# token instead, create one in Grafana, store it in this item and uncomment:
# TF_VAR_grafana_auth_token=op://private/homenet-grafana/auth-token
TF_VAR_grafana_admin_email=op://private/homenet-grafana/email
