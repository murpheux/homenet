# 1Password secret references, resolved at runtime by `op run`. No secret values here; safe to commit.
# Item "homenet-elk" in vault "private"; create it once with `make create-secrets`.
TF_VAR_elastic_password=op://private/homenet-elk/password
TF_VAR_kibana_system_password=op://private/homenet-elk/kibana-system-password
TF_VAR_kibana_encryption_key=op://private/homenet-elk/kibana-encryption-key
TF_VAR_filebeat_password=op://private/homenet-elk/filebeat-password
