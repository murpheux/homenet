# 1Password secret references, resolved at runtime by `op run`. No secret values here; safe to commit.
# Item "homenet-database" in vault "private"; one "user" field serves MongoDB and PostgreSQL.
TF_VAR_mysql_root_password=op://private/homenet-database/mysql-root-password
TF_VAR_mongo_user=op://private/homenet-database/user
TF_VAR_mongo_password=op://private/homenet-database/mongo-password
TF_VAR_postgres_user=op://private/homenet-database/user
TF_VAR_postgres_password=op://private/homenet-database/postgres-password
TF_VAR_sqlserver_sa_password=op://private/homenet-database/sqlserver-sa-password
TF_VAR_redis_password=op://private/homenet-database/redis-password
