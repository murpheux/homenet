<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
<plist version="1.0">
<dict>
    <!-- Unique identifier for the service -->
    <key>Label</key>
    <string>com.ngrok.agent</string>

    <!-- Path to the executable and arguments -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/ngrok</string>
        <string>start</string>
        <string>--all</string>
        <string>--config</string>
        <string>/Users/murpheux/.config/ngrok/ngrok.yml</string>
    </array>

    <!-- Keep the service running persistently -->
    <key>KeepAlive</key>
    <true/>

    <!-- Start immediately when loaded -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Standard log tracking for debugging -->
    <key>StandardOutPath</key>
    <string>/tmp/ngrok.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ngrok.err.log</string>
</dict>
</plist>

